# Copy to .env.local for development. Set these in Vercel for deployments.
# Required: Clerk Dashboard > API keys (use matching keys from one instance).
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Google Maps: enable Maps JavaScript API and Geocoding API.
# Restrict this browser key to your localhost and deployed domains.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# Optional: custom map style. The app falls back to DEMO_MAP_ID.
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=

# Optional: Claude-powered city assistant; without it the API returns 503.
ANTHROPIC_API_KEY=

# Optional: comma-separated verified emails allowed to act as city staff.
CITY_STAFF_EMAILS=

# Persistent reports and bounties (server-only). These defaults match compose.yaml for LOCAL development.
# Replace with managed database/bucket settings in production; see docs/reporting-storage.md.
DATABASE_URL=postgresql://civic:local-development-only@localhost:5432/civic
REPORTS_S3_BUCKET=civic-reports
REPORTS_S3_REGION=us-east-1
REPORTS_S3_ENDPOINT=http://localhost:9000
REPORTS_S3_FORCE_PATH_STYLE=true
REPORTS_S3_ACCESS_KEY_ID=civic-local
REPORTS_S3_SECRET_ACCESS_KEY=local-development-only
